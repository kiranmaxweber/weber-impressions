# Copy to .env and fill in. .env is gitignored.

# Required. The reviewer supplies their own key; the server exits with one line if missing.
ANTHROPIC_API_KEY=

# Optional. Without it, escalations to Weber Impressions display the handoff payload
# instead of creating a real Zendesk ticket. See CLAUDE.md — Escalation.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
