# Copy to .env and fill in. .env is gitignored.

# Required. The reviewer supplies their own key; the server exits with one line if missing.
ANTHROPIC_API_KEY=

# Optional. Without these, escalations to Weber Impressions display the handoff payload
# instead of creating a real Zendesk ticket. OAuth client credentials — Admin Center →
# Apps and integrations → APIs → OAuth clients. See CLAUDE.md — Escalation.
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
